# Copiá este archivo como .env. Los dos valores obligatorios se dejan vacíos
# deliberadamente: docker compose se negará a iniciar hasta que los definas.
MBAPO_AUTH_SECRET=
PORT=3001
POSTGRES_DB=mbapo
POSTGRES_USER=mbapo
POSTGRES_PASSWORD=
# Solo para `npm run api` fuera de Docker. Usá la contraseña codificada para URL.
# DATABASE_URL=postgresql://mbapo:your-url-encoded-password@localhost:5432/mbapo
# Puertos publicados por compose; PostgreSQL siempre queda ligado a localhost.
POSTGRES_PORT=5432
APP_PORT=3001
APP_BIND_ADDRESS=127.0.0.1
# Set to demo only during local development. Production requires Stripe.
PAYMENTS_MODE=demo
# Enable only behind a known reverse proxy that sets client IP headers.
TRUST_PROXY=false
# Use silent for test runs; JSON request logs are enabled otherwise.
LOG_LEVEL=info
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
