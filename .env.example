# Change this before exposing the API publicly.
MBAPO_AUTH_SECRET=replace-with-a-long-random-secret
PORT=3001
POSTGRES_DB=mbapo
POSTGRES_USER=mbapo
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://mbapo:change-this-local-password@localhost:5432/mbapo
# Set to demo only during local development. Production requires Stripe.
PAYMENTS_MODE=demo
# Enable only behind a known reverse proxy that sets client IP headers.
TRUST_PROXY=false
# Use silent for test runs; JSON request logs are enabled otherwise.
LOG_LEVEL=info
# DATABASE_SSL=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
